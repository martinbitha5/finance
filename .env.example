# Copy to .env.local
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# E-mails transactionnels (envoi du rapport Excel + CSV) via Brevo, côté serveur uniquement.
# Transport 1 (recommandé) : API HTTP v3 — clé xkeysib-… (https://app.brevo.com/settings/keys/api)
BREVO_API_KEY=
# Transport 2 (si BREVO_API_KEY est vide) : SMTP — clé xsmtpsib-… + login (https://app.brevo.com/settings/keys/smtp)
BREVO_SMTP_KEY=
BREVO_SMTP_LOGIN=
# Expéditeur validé dans Brevo (Paramètres → Expéditeurs)
MAIL_FROM_EMAIL=martinbitha6@gmail.com
MAIL_FROM_NAME=MONY

# Notifications push (Web Push). Generer avec : node -e "console.log(require('web-push').generateVAPIDKeys())"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@example.com

# Cron des notifications push (envoi quotidien app fermee, /api/push-cron)
# Cle secrete Supabase (sb_secret_..., dashboard : Settings -> API keys) — serveur uniquement.
SUPABASE_SECRET_KEY=
# Secret partage avec Vercel Cron (valeur libre, Vercel l'ajoute en Authorization: Bearer)
CRON_SECRET=
